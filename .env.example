# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real credentials.
#
# Reddit (only needed for --backend praw):
# Get these from https://www.reddit.com/prefs/apps -> "create another app..."
# -> type "script". See README.md for the full walkthrough.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=yourshopname-demand-scan/0.1 by u/yourusername

# X / Twitter (optional — pay-per-use API as of 2026):
# Create an app at https://developer.x.com and paste the Bearer Token.
# Without this, x_scan.py uses x_manual_log.csv instead.
# Run `python3 x_scan.py --estimate` before enabling to see cost ceiling.
X_BEARER_TOKEN=

# YouTube Data API v3 (optional free social/content signal):
# 1. console.cloud.google.com → enable YouTube Data API v3
# 2. Create an API key; restrict it to YouTube Data API v3
# 3. Estimate quota: python3 youtube_scan.py --estimate
# Without this, youtube_scan writes zeros and score_demand redistributes.
YOUTUBE_API_KEY=

# eBay sold listings via SoldComps (optional transaction signal):
# 1. Create free account at https://sold-comps.com
# 2. Dashboard → API keys (keys start with sc_)
# 3. Estimate: python3 ebay_sold_scan.py --estimate
# Without this, ebay_sold_scan writes zeros and score_demand redistributes.
EBAY_SOLD_API_KEY=

# Etsy Open API v3 (optional marketplace signal — active listings + favorites):
# 1. https://www.etsy.com/developers/ → register an app
# 2. Copy keystring + shared secret
# 3. Prefer single env value:
#      ETSY_API_KEY=keystring:shared_secret
#    Or split:
#      ETSY_KEYSTRING=...
#      ETSY_SHARED_SECRET=...
# 4. Estimate: python3 etsy_scan.py --estimate
# Note: Open API does not expose public sold counts; sold_proxy stays 0 and
# scoring uses favorites as engagement proxy. Soft-fails without a key.
ETSY_API_KEY=
# ETSY_KEYSTRING=
# ETSY_SHARED_SECRET=

# DataForSEO (Google Ads keyword metrics):
# Credentials from https://app.dataforseo.com/api-access
# Used by:
#   - search_volume_scan.py          (product demand volume)
#   - local_service_keywords_scan.py (local service keyword volumes)
#   - local_service_market_scan.py   (PAA questions + Maps competitors)
# Run `--estimate` before the first real call. Results cached under cache/.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google Sheets export (export_to_sheets.py — final step of run_all.sh):
# 1. Create a Google Cloud service account, enable Sheets API
# 2. Download the JSON key; store outside git (see docs/sheets_setup.md)
# 3. Share your spreadsheet with the service account email (Editor)
# 4. Paste the spreadsheet ID from the URL:
#    https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
