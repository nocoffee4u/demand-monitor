{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceHealthSnapshot",
  "type": "object",
  "required": ["ts", "run_id", "sources"],
  "properties": {
    "ts": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["OK", "STALE", "BLOCKED", "AUTH", "EMPTY_UNEXPECTED", "SKIPPED"]
          },
          "detail": { "type": ["string", "null"] },
          "last_ok": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Optional SLA: last successful OK timestamp"
          },
          "consecutive_failures": {
            "type": "integer",
            "minimum": 0,
            "description": "Optional SLA: consecutive non-OK outcomes"
          },
          "owner": {
            "type": "string",
            "enum": ["forecasting", "ui", "manual", "context", ""],
            "description": "Optional SLA owner: forecasting | ui | manual | context | blank"
          }
        }
      }
    },
    "alert_user": { "type": "boolean" }
  }
}
