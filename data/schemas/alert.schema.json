{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlertsFile",
  "description": "Daily alert routing file at data/alerts/YYYY-MM-DD.json. Prefer ONE notify channel (Grok Bot app or email somomfg@gmail.com). See alert_routing.md for severity mapping.",
  "type": "object",
  "required": ["run_id", "ts", "alerts"],
  "properties": {
    "run_id": { "type": "string" },
    "ts": { "type": "string", "format": "date-time" },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alert_user", "severity", "kind"],
        "properties": {
          "alert_user": { "type": "boolean" },
          "severity": {
            "type": "string",
            "enum": ["info", "warn", "critical"],
            "description": "BLOCKED important source → critical; OEM OOS→in-stock Path A → warn; ≥3× 1–2★ same accessory pain in 7d → warn; STALE important → warn"
          },
          "kind": {
            "type": "string",
            "enum": ["source_blocked", "oem_stock_flip", "review_cluster", "other"]
          },
          "names": {
            "type": "array",
            "items": { "type": "string" }
          },
          "detail": { "type": "string" },
          "opportunity_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
