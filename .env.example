# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real credentials.
#
# Reddit (only needed for --backend praw):
# Get these from https://www.reddit.com/prefs/apps -> "create another app..."
# -> type "script". See README.md for the full walkthrough.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=yourshopname-demand-scan/0.1 by u/yourusername

# X / Twitter (optional — pay-per-use API as of 2026):
# Create an app at https://developer.x.com and paste the Bearer Token.
# Without this, x_scan.py uses x_manual_log.csv instead.
# Run `python3 x_scan.py --estimate` before enabling to see cost ceiling.
X_BEARER_TOKEN=

# DataForSEO (search volume via Google Ads API — primary demand signal):
# Credentials from https://app.dataforseo.com/api-access
# Run `python3 search_volume_scan.py --estimate` before the first real call.
# Results are cached under cache/ (default refresh: weekly).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
